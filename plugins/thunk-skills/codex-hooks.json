{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/codex/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*thunk.*__(create_thunk|batch_steps|run_work_item|get_errors|batch_connections|run_review)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/codex/post-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
